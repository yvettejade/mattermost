# Cursor
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# Target repository for cloud agents
REPO_URL=https://github.com/yvettejade/mattermost
GITHUB_DEFAULT_BRANCH=master
# PAT with pull_requests:write (mark draft PRs ready for review; QA labels/comments)
GITHUB_TOKEN=
# Optional. If set, POST /webhooks/github requires X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=

# Jira
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Optional. If set, POST /webhooks/jira requires header X-Pipeline-Secret.
# Leave empty for local/dev (no auth on the webhook).
PIPELINE_WEBHOOK_SECRET=

# Optional: poll Jira for new tickets instead of (or in addition to) webhooks
JIRA_POLL_ENABLED=false
JIRA_POLL_INTERVAL_SECONDS=60
JIRA_POLL_JQL=

# Optional Slack notify after implement opens a PR
SLACK_WEBHOOK_URL=

DATABASE_PATH=data/pipeline.db
